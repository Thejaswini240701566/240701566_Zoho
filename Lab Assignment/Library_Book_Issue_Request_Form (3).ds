 application "Library Book Issue Request Form"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Library_Book_Issue_Advanced_Request_Form
		{
			displayname = "Library Book Issue Advanced Request Form"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			book_title_lookup
			(
				type = list	
				displayname = "Book Title Lookup"
				values  = Library_Book_Issue_Request_Form.ID
    			displayformat = [ID]
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			request_submitted_on
			(
    			type = datetime
				displayname = "Request Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			faculty_recommendation_upload
			(
    			type = upload file
				displayname = "Faculty Recommendation Upload"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Library_Rules_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, alignment, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			special_request_voice_note
			(
     			type = audio
				displayname = "Special Request Voice Note"
    			duration=60
	 			row = 1
	 			column = 1   
				width = medium
			)
			book_cover_image
			(
    			type = image
				displayname = "Book Cover Image"
				source  = file
				aspect ratio = original
				camera = primary
	 			row = 1
	 			column = 1   
				width = medium
			)
			book_review_video
			(
    			type = video
				displayname = "Book Review Video"
    			duration=30
	 			row = 1
	 			column = 1   
				width = medium
			)
			ebook_reference_url
			(
    			type = url
				displayname = "Ebook Reference URL"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_digital_signature
			(
    			type = signature
				displayname = "Member Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			book_issue_qr_code
			(
    			type = text
				displayname = "Book Issue QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Late_Fee_Waiver_Percent
			(
    			type = percentage
	 			row = 1
	 			column = 1   
				width = medium
			)
			Request_Home_Delivery
			(
				type = picklist
				displayname = "Request Home Delivery"
				maxchar = 100
				values = {"Yes","No"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Library_Book_Issue_Request_Form
		{
			displayname = "Library Book Issue Request Form"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Member_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			unique Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Hostel_Residential_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have unique Contact_Number
			(
    			type = phonenumber
    			allowedcountries={in}
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have unique Register_Roll_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Purpose_Of_Borrowing
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Number_Of_Copies
			(
				type = number
				maxchar = 1
				initial value = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Issue_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Collection_Time
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
				allowedhours = 06:00-21:00
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Book_Category
			(
				type = picklist
				maxchar = 100
				values = {"CSE","AIML","AIDS","CSBS","CSE-CS","CSD","IT"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Member_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"Student","Faculty","Staff"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Subject_Areas_Of_Interest
			(
				type = list	
				values = {"Artificial Intelligence","Data Science,","Machine Learning"}
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Agree_To_Library_Rules
			(
				type = checkboxes	
				values = {"I agree to the library rules and return policy"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Library_Book_Issue_Request_Form_Report
		{
			displayName = "Library Book Issue Request Form Report"
			show all rows from Library_Book_Issue_Request_Form    
			(
				Member_Name 
				Hostel_Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Register_Roll_Number
				Purpose_Of_Borrowing
				Number_Of_Copies
				Preferred_Issue_Date
				Preferred_Collection_Time
				Book_Category
				Member_Type
				Subject_Areas_Of_Interest
				Agree_To_Library_Rules
			)
		}
		default list Library_Book_Issue_Request_Form1_Report
		{
			displayName = "Library Book Issue Request Form Report"
			show all rows from Library_Book_Issue_Advanced_Request_Form    
			(
				book_title_lookup as "Book Title Lookup"
				request_submitted_on as "Request Submitted On"
				member_digital_signature as "Member Digital Signature"
				faculty_recommendation_upload as "Faculty Recommendation Upload"
				special_request_voice_note as "Special Request Voice Note"
				book_review_video as "Book Review Video"
				book_cover_image as "Book Cover Image"
				ebook_reference_url as "Ebook Reference URL"
				book_issue_qr_code as "Book Issue QR Code"
				Request_Home_Delivery as "Request Home Delivery"
				Library_Rules_Display
				Late_Fee_Waiver_Percent
			)
		}
		spreadsheet Issue_Requests_Spreadsheet
		{
			displayName = "Issue_Requests_Spreadsheet"
			show all rows from Library_Book_Issue_Request_Form    
			(
				Member_Name 
				Email_Address
				Hostel_Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Register_Roll_Number
				Purpose_Of_Borrowing
				Number_Of_Copies
				Preferred_Issue_Date
				Preferred_Collection_Time
				Book_Category
				Member_Type
				Subject_Areas_Of_Interest
				Agree_To_Library_Rules
			)
		}
	}
