		workflow
		{

		schedule
		{
			DueDate_Reminder as "DueDate_Reminder"
			{
				type =  schedule
				start = "2026-11-10 22:53:03"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.adminuserid"
							subject : "Due date remainder"
							message : "<div>Please return the books you borrowed before the due date. Thankyou.</div>"
							attachments : view : Library_Book_Issue_Request_Form_Report as PDF
						)
					}
				}
			}
		}




